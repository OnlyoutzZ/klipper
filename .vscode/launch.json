{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "N32H760 - shared J-Link (Launch)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/out/klipper.elf",
      "gdbPath": "/usr/bin/gdb-multiarch",
      "objdumpPath": "/usr/bin/objdump",
      "nmPath": "/usr/bin/nm",
      "servertype": "external",
      "gdbTarget": "localhost:2331",
      "device": "N32H760ZI",
      "interface": "swd",
      "runToEntryPoint": "armcm_main",
      "preLaunchTask": "debug: prepare",
      "preLaunchCommands": [
        "monitor reset halt"
      ],
      "showDevDebugOutput": "none"
    },
    {
      "name": "N32H760 - shared J-Link (Attach)",
      "type": "cortex-debug",
      "request": "attach",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/out/klipper.elf",
      "gdbPath": "/usr/bin/gdb-multiarch",
      "objdumpPath": "/usr/bin/objdump",
      "nmPath": "/usr/bin/nm",
      "servertype": "external",
      "gdbTarget": "localhost:2331",
      "device": "N32H760ZI",
      "interface": "swd",
      "postAttachCommands": [
        "monitor halt"
      ],
      "showDevDebugOutput": "none"
    }
  ]
}
